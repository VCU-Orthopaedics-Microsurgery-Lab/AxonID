# Line endings: stored as LF in the repository; Git converts text files to the
# platform's native line ending on checkout. Shell scripts must stay LF so they
# run on Linux/macOS even when checked out on Windows.
* text=auto
*.sh     text eol=lf
*.sbatch text eol=lf
*.ps1    text eol=crlf
*.bat    text eol=crlf

# Binary files: never convert, never diff as text.
*.pt   binary
*.pth  binary
*.tif  binary
*.tiff binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.xlsx binary
*.zip  binary
*.npz  binary
